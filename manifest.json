{
  "manifest_version": 3,
  "name": "LocalTrack",
  "version": "1.0",
  "description": "Privacy-first local time tracker",
  "permissions": ["storage", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "48": "icon.png"
  }
}